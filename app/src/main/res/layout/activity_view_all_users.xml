<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/settings_background_color">

    <TextView
        android:id="@+id/titleUsers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Users"
        android:textSize="24sp"
        android:textStyle="bold"
        android:paddingBottom="12dp"
        android:textColor="@color/settings_text_color"/>

    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search by name, email, or ID"
        android:inputType="text"
        android:padding="12dp"
        android:singleLine="true"
        android:background="@drawable/bg_settings_section"
        android:textColor="@color/settings_text_color"
        android:textColorHint="@color/settings_answer_text_color"/>

    <TextView
        android:id="@+id/emptyStateText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No users found"
        android:visibility="gone"
        android:paddingTop="16dp"
        android:gravity="center"
        android:textSize="16sp"
        android:textColor="@color/settings_text_color"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/usersRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="12dp" />

</LinearLayout>
