<?xml version="1.0" encoding="utf-8"?>
<!-- One chat row: assistant (start, no bubble) OR user (end, bubble). We toggle visibility in the adapter. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Assistant container (start/left). Visible for assistant messages -->
    <LinearLayout
        android:id="@+id/containerBot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:layout_marginEnd="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textBotMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/item_message_assistant_message"
            android:textColor="@color/textColorMain"
            android:textSize="@dimen/item_message_textSize"
            android:lineSpacingExtra="2dp"
            android:textDirection="firstStrong"
            android:textAlignment="viewStart"
            android:padding="0dp" />

        <ProgressBar
            android:id="@+id/botThinkingSpinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- User container (end/right). Visible for user messages -->
    <LinearLayout
        android:id="@+id/containerUser"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        app:layout_constraintStart_toEndOf="@id/guidelineCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <!-- Preview of the photos in the text -->
        <HorizontalScrollView
            android:id="@+id/userImagesScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:overScrollMode="ifContentScrolls"
            android:visibility="gone"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:id="@+id/userImagesContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- The text that was sent by the user -->
        <TextView
            android:id="@+id/textUserMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_msg_user"
            android:text="@string/item_message_user_message"
            android:textColor="@color/textColorMain"
            android:textSize="@dimen/item_message_textSize"
            android:lineSpacingExtra="2dp"
            android:textDirection="firstStrong"
            android:textAlignment="viewStart"
            android:padding="8dp" />
    </LinearLayout>

    <!-- 50% vertical guideline to keep bubbles from stretching full width -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

</androidx.constraintlayout.widget.ConstraintLayout>
